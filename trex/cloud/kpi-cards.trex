<?xml version="1.0" encoding="utf-8"?>
<!-- Source manifest. The BASE_URL placeholder in the url is filled in by tools/make_trex.py, which writes
     trex/local/kpi-cards.trex (localhost) and trex/cloud/kpi-cards.trex (GitHub Pages).
     Bump extension-version on every change you publish.
     Tableau allows at most 4 custom encodings; more inputs go on the built-in Detail tile. -->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.bleckmann.viz.kpicards" extension-version="2.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>KPI cards with target status, delta versus a comparison value, sparkline and detail lines</description>
    <author name="Bleckmann BI" email="noreply@bleckmann.com" organization="Bleckmann" website="https://www.bleckmann.com"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://yannickbue.github.io/tableau-viz-extensions/extensions/kpi-cards/index.html</url>
    </source-location>
    <icon/>
    <encoding id="card">
      <display-name>Card / Date</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="2"/>
      <tooltip>One text field = one card per member. One date field = sparkline over time. Both are allowed.</tooltip>
    </encoding>
    <encoding id="value">
      <display-name>Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>The headline number</tooltip>
    </encoding>
    <encoding id="target">
      <display-name>Target, Amber</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="2"/>
      <tooltip>First field = target. Optional second field = amber threshold; amber above target means lower is better.</tooltip>
    </encoding>
    <encoding id="compare">
      <display-name>Compare</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Delta is shown against this value, for example the previous period</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Bleckmann KPI Cards</text>
    </resource>
  </resources>
</manifest>
